raw `
LittlerootSouth_MysticGrove_MapScripts::
	.byte 0

`

mapscripts MysticGrove_MapScripts {

}

script MysticGrove_CheckWeather {
	lockall
	msgbox("The current weather is:\n",MSGBOX_NPC)
	switch(var(VAR_WEATHER_CURRENT)){
		case 0: msgbox("Clear.", MSGBOX_NPC)
		case 1: msgbox("Rain.", MSGBOX_NPC)
		case 2: msgbox("Thunder.", MSGBOX_NPC)
		case 3: msgbox("Snow.", MSGBOX_NPC)
		case 4: msgbox("Snow.", MSGBOX_NPC)
		case 5: msgbox("Fog.", MSGBOX_NPC)
		default: msgbox("Undefined.")
	}
//	DrawWholeMapView
	releaseall
}

script MysticGrove_Chrono {
	lockall
	msgbox("Change Time?", MSGBOX_YESNO)
	if(var(VAR_RESULT)){
		dynmultichoice(25, 3, FALSE, 4, 0, DYN_MULTICHOICE_CB_NONE, "Morning", "Day", "Evening", "Night")
		closemessage
		switch(var(VAR_RESULT)){
			case 0: fwdtime(20,9)	// Morning
			case 1: fwdtime(23,9)	// Day
			case 2: fwdtime(07,129)	// Evening
			case 3: fwdtime(12,9)	// Night
			}
		fadescreen(FADE_TO_BLACK)
		msgbox("CHRONOMANCY!", MSGBOX_NPC)
//		DrawWholeMapView
		fadescreen(FADE_FROM_BLACK)
		}
	else{}
	releaseall
}

script MysticGrove_Meteoro {
	lockall
	msgbox("Change Weather?", MSGBOX_YESNO)
	if(var(VAR_RESULT)){
		dynmultichoice(25, 3, FALSE, 4, 0, DYN_MULTICHOICE_CB_NONE, "Clear", "Rain", "Thunder", "Snow", "Sandstorm", "Fog")
		closemessage
		switch(var(VAR_RESULT)){
			case 0: setweather(WEATHER_NONE)				// Clear
					setvar(VAR_WEATHER_CURRENT, 0)
			case 1: setweather(WEATHER_RAIN)				// Rain
					setvar(VAR_WEATHER_CURRENT, 1)
			case 2: setweather(WEATHER_RAIN_THUNDERSTORM)	// Thunder
					setvar(VAR_WEATHER_CURRENT, 2)
			case 3: setweather(WEATHER_SNOW)				// Snow
					setvar(VAR_WEATHER_CURRENT, 3)
			case 4: setweather(WEATHER_SANDSTORM)			// Sandstorm
					setvar(VAR_WEATHER_CURRENT, 4)
			case 5: setweather(WEATHER_FOG_HORIZONTAL)		// Fog
					setvar(VAR_WEATHER_CURRENT, 5)
			}
		doweather
		fadescreen(FADE_TO_BLACK)
		msgbox("METEOROMANCY!", MSGBOX_NPC)
//		MysticGrove_SetEncounterTable
		fadescreen(FADE_FROM_BLACK)
		}
	else{}
	releaseall
}