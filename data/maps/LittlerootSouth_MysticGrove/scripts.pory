raw `
LittlerootSouth_MysticGrove_MapScripts::
	.byte 0

`

mapscripts MysticGrove_MapScripts {
//	  MAP_SCRIPT_ON_TRANSITION: 
}

script MysticGrove_Chrono {
	lockall
	msgbox("Change Time?", MSGBOX_YESNO)
	if(var(VAR_RESULT)){
		dynmultichoice(25, 3, FALSE, 4, 0, DYN_MULTICHOICE_CB_NONE, "Morning", "Day", "Evening", "Night")
		closemessage
		switch(var(VAR_RESULT)){
			case 0: fwdtime(20,9)	// Morning
			case 1: fwdtime(23,9)	// Day
			case 2: fwdtime(07,69)	// Evening
			case 3: fwdtime(11,9)	// Night
			}
		msgbox("CHRONOMANCY!")
		}
	else{}
	releaseall
}

script MysticGrove_Meteoro {
	lockall
	msgbox("Change Weather?", MSGBOX_YESNO)
	if(var(VAR_RESULT)){
		dynmultichoice(25, 3, FALSE, 4, 0, DYN_MULTICHOICE_CB_NONE, "Clear", "Sandstorm", "Rain", "Thunder", "Snow", "Fog")
		closemessage
		switch(var(VAR_RESULT)){
			case 0: setweather(WEATHER_NONE)				// Clear
			case 1: setweather(WEATHER_SANDSTORM)			// Sandstorm
			case 2: setweather(WEATHER_RAIN)				// Rain
			case 3: setweather(WEATHER_RAIN_THUNDERSTORM)	// Thunder
			case 4: setweather(WEATHER_SNOW)				// Snow
			case 5: setweather(WEATHER_FOG_HORIZONTAL)		// Fog
			}
		doweather
		msgbox("METEOROMANCY!")
		}
	else{}
	releaseall
}

script MysticGrove_Flower {
	if(!flag(FLAG_MG_FLOWER)){
		lockall
		emote_exclamation_mark
		msgbox(format("HEY!\p\n Get off of my face!"), MSGBOX_NPC)
		setflag(FLAG_MG_FLOWER)
		releaseall
	}
	else{}
}